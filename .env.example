# Supabase connection for the Talent_Interface client.
#
# The VITE_ prefix is REQUIRED. Vite only exposes variables beginning with VITE_
# to the app; anything else is invisible to src/supabase.ts and the app will throw
# at startup with "Supabase environment variables are missing or invalid".
#
# Local development: copy this file to .env.local and fill in the values.
# Cloudflare Workers: set these as BUILD variables, not runtime variables. Vite
# inlines them at build time, and a static-assets Worker runs no code, so runtime
# bindings never reach the app.

VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-SUPABASE-ANON-KEY"